CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# --------------------------------------------------
# Bar Configuration
# --------------------------------------------------
# A completely transparent bar.
sketchybar --bar \
  position=top \
  height=20 \
  color=0x00000000 \
  shadow=off \
  sticky=on \
  topmost=on \
  drawing=off

# --------------------------------------------------
# The Single Item: Current App
# --------------------------------------------------
# We add ONE item and apply the background directly to it.
# This is the simplest possible way to create a visible element.
sketchybar --add item app right \
           --set app \
                 script="$PLUGIN_DIR/app_script.sh" \
                 label.font="Hack Nerd Font:Regular:11.0" \
                 label.color=0xffffffff \
                 label.padding_left=10 \
                 label.padding_right=10 \
                 background.height=20 \
                 background.color=0xcc1a1a1a \
                 background.corner_radius=10 \
           --subscribe app front_app_switched

sketchybar --update
